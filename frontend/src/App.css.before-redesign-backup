/* =========================================================
   MIMIC DEBUGLAB
   ========================================================= */

.debuglab-shell {
  width: min(1480px, 94vw);
  height: min(860px, 90vh);
  overflow: hidden;
}

.debuglab-subtitle {
  margin-top: 8px;
  color: rgba(255, 255, 255, 0.48);
  font-size: 13px;
  letter-spacing: 0.01em;
}

.debuglab-toolbar {
  display: grid;
  grid-template-columns: 1fr auto auto;
  align-items: center;
  gap: 28px;
  padding: 18px 28px;
  border-top: 1px solid rgba(255,255,255,.06);
  border-bottom: 1px solid rgba(255,255,255,.08);
  background: rgba(255,255,255,.025);
}

.debuglab-task-info {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.debuglab-task-label {
  font-size: 9px;
  letter-spacing: .16em;
  color: rgba(255,255,255,.36);
}

.debuglab-task-info strong {
  font-size: 14px;
  font-weight: 500;
  color: rgba(255,255,255,.86);
}

.debuglab-progress {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 210px;
  font-family: monospace;
  font-size: 9px;
  letter-spacing: .08em;
  color: rgba(255,255,255,.42);
}

.debuglab-progress-track {
  width: 90px;
  height: 3px;
  border-radius: 99px;
  overflow: hidden;
  background: rgba(255,255,255,.09);
}

.debuglab-progress-fill {
  height: 100%;
  background: rgba(255,255,255,.8);
  transition: width .35s ease;
}

.debuglab-reset {
  padding: 8px 13px;
  border: 1px solid rgba(255,255,255,.1);
  border-radius: 7px;
  background: rgba(255,255,255,.035);
  color: rgba(255,255,255,.5);
  font-family: monospace;
  font-size: 9px;
  letter-spacing: .1em;
  cursor: pointer;
}

.debuglab-reset:hover {
  color: white;
  border-color: rgba(255,255,255,.22);
}

/* Main three-column workspace */

.debuglab-body {
  position: relative;
  display: grid;
  grid-template-columns: 190px minmax(0, 1fr) 310px;
  height: calc(100% - 170px);
  min-height: 0;
}

.debuglab-sidebar {
  min-width: 0;
  padding: 20px 14px;
  border-right: 1px solid rgba(255,255,255,.07);
  background: rgba(255,255,255,.018);
}

.debuglab-sidebar-title {
  padding: 0 8px 12px;
  color: rgba(255,255,255,.32);
  font-family: monospace;
  font-size: 9px;
  letter-spacing: .14em;
}

.debuglab-file-list {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.debuglab-file {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 10px 9px;
  border: 1px solid transparent;
  border-radius: 7px;
  background: transparent;
  color: rgba(255,255,255,.48);
  text-align: left;
  font-family: monospace;
  font-size: 11px;
  cursor: pointer;
}

.debuglab-file:hover {
  background: rgba(255,255,255,.045);
  color: rgba(255,255,255,.85);
}

.debuglab-file.active {
  border-color: rgba(255,255,255,.1);
  background: rgba(255,255,255,.065);
  color: white;
}

.debuglab-file-icon {
  width: 22px;
  color: rgba(255,255,255,.3);
  font-size: 8px;
}

.debuglab-check {
  margin-left: auto;
  color: rgba(255,255,255,.75);
}

.debuglab-sidebar-divider {
  height: 1px;
  margin: 20px 8px;
  background: rgba(255,255,255,.07);
}

.debuglab-run-button {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
  padding: 11px;
  border: 1px solid rgba(255,255,255,.13);
  border-radius: 7px;
  background: rgba(255,255,255,.055);
  color: rgba(255,255,255,.8);
  font-family: monospace;
  font-size: 9px;
  letter-spacing: .1em;
  cursor: pointer;
}

.debuglab-run-button:hover,
.debuglab-run-button.passed {
  background: rgba(255,255,255,.1);
  border-color: rgba(255,255,255,.25);
  color: white;
}

.debuglab-test-status {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16px;
  padding: 10px 8px;
  border: 1px solid rgba(255,255,255,.06);
  border-radius: 7px;
  background: rgba(255,255,255,.025);
}

.debuglab-status-label {
  color: rgba(255,255,255,.28);
  font-family: monospace;
  font-size: 8px;
  letter-spacing: .08em;
}

.debuglab-status-idle,
.debuglab-status-ready {
  color: rgba(255,255,255,.42);
  font-family: monospace;
  font-size: 8px;
}

.debuglab-status-failed {
  color: rgba(255,255,255,.72);
  font-family: monospace;
  font-size: 8px;
}

.debuglab-status-passed {
  color: rgba(255,255,255,.9);
  font-family: monospace;
  font-size: 8px;
}

/* Editor */

.debuglab-editor {
  min-width: 0;
  min-height: 0;
  display: flex;
  flex-direction: column;
  background: #070707;
}

.debuglab-editor-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 11px 18px;
  border-bottom: 1px solid rgba(255,255,255,.06);
  background: rgba(255,255,255,.018);
}

.debuglab-breadcrumb,
.debuglab-editor-state {
  color: rgba(255,255,255,.32);
  font-family: monospace;
  font-size: 9px;
  letter-spacing: .08em;
}

.debuglab-code-window {
  flex: 1;
  min-height: 0;
  display: grid;
  grid-template-columns: 48px minmax(0,1fr);
  overflow: auto;
}

.debuglab-line-numbers {
  display: flex;
  flex-direction: column;
  padding: 20px 10px;
  border-right: 1px solid rgba(255,255,255,.04);
  background: rgba(255,255,255,.012);
  color: rgba(255,255,255,.18);
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 12px;
  line-height: 1.8;
  text-align: right;
  user-select: none;
}

.debuglab-code {
  margin: 0;
  padding: 20px 24px;
  color: rgba(255,255,255,.72);
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 12px;
  line-height: 1.8;
  white-space: pre-wrap;
  overflow: visible;
}

.debuglab-fix-panel,
.debuglab-success-panel {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  margin: 14px 18px;
  padding: 15px 17px;
  border: 1px solid rgba(255,255,255,.11);
  border-radius: 9px;
  background: rgba(255,255,255,.045);
}

.debuglab-fix-panel > div,
.debuglab-success-panel > div {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.debuglab-fix-tag {
  color: rgba(255,255,255,.35);
  font-family: monospace;
  font-size: 8px;
  letter-spacing: .14em;
}

.debuglab-fix-panel strong,
.debuglab-success-panel strong {
  color: rgba(255,255,255,.82);
  font-size: 12px;
  font-weight: 500;
}

.debuglab-fix-panel p {
  margin: 0;
  color: rgba(255,255,255,.38);
  font-size: 10px;
}

.debuglab-fix-button {
  flex-shrink: 0;
  padding: 10px 15px;
  border: 1px solid rgba(255,255,255,.18);
  border-radius: 7px;
  background: rgba(255,255,255,.08);
  color: white;
  font-family: monospace;
  font-size: 9px;
  letter-spacing: .08em;
  cursor: pointer;
}

.debuglab-fix-button:hover {
  background: rgba(255,255,255,.14);
}

.debuglab-success-panel {
  justify-content: flex-start;
}

.debuglab-success-icon {
  width: 30px;
  height: 30px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(255,255,255,.15);
  border-radius: 50%;
  color: white;
}

.debuglab-success-panel span:last-child {
  color: rgba(255,255,255,.38);
  font-size: 10px;
}

/* Workflow panel */

.debuglab-workflow {
  min-width: 0;
  padding: 18px;
  border-left: 1px solid rgba(255,255,255,.07);
  background: rgba(255,255,255,.018);
  overflow-y: auto;
}

.debuglab-workflow-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: rgba(255,255,255,.52);
  font-family: monospace;
  font-size: 9px;
  letter-spacing: .12em;
}

.debuglab-workflow-header button {
  border: 0;
  background: transparent;
  color: rgba(255,255,255,.3);
  font-size: 18px;
  cursor: pointer;
}

.debuglab-workflow-note {
  margin: 14px 0 18px;
  padding: 11px;
  border-left: 1px solid rgba(255,255,255,.18);
  color: rgba(255,255,255,.35);
  font-size: 10px;
  line-height: 1.5;
}

.debuglab-workflow-list {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.debuglab-workflow-step {
  display: grid;
  grid-template-columns: 28px 1fr;
  gap: 10px;
  padding: 11px 9px;
  border: 1px solid transparent;
  border-radius: 8px;
  opacity: .55;
  transition: all .25s ease;
}

.debuglab-workflow-step.completed {
  opacity: 1;
  border-color: rgba(255,255,255,.08);
  background: rgba(255,255,255,.045);
}

.debuglab-step-number {
  width: 24px;
  height: 24px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 50%;
  color: rgba(255,255,255,.5);
  font-family: monospace;
  font-size: 8px;
}

.debuglab-workflow-step.completed .debuglab-step-number {
  color: white;
  border-color: rgba(255,255,255,.3);
}

.debuglab-step-content {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.debuglab-step-content strong {
  color: rgba(255,255,255,.72);
  font-size: 10px;
  font-weight: 500;
}

.debuglab-step-content span {
  color: rgba(255,255,255,.3);
  font-size: 9px;
  line-height: 1.45;
}

.debuglab-show-workflow {
  position: absolute;
  right: 14px;
  top: 14px;
  padding: 9px 12px;
  border: 1px solid rgba(255,255,255,.12);
  border-radius: 7px;
  background: rgba(0,0,0,.75);
  color: rgba(255,255,255,.55);
  font-family: monospace;
  font-size: 8px;
  cursor: pointer;
}

/* Responsive */

@media (max-width: 1050px) {
  .debuglab-body {
    grid-template-columns: 160px minmax(0,1fr);
  }

  .debuglab-workflow {
    display: none;
  }

  .debuglab-toolbar {
    grid-template-columns: 1fr auto;
  }

  .debuglab-progress {
    display: none;
  }
}

@media (max-width: 700px) {
  .debuglab-shell {
    width: 96vw;
    height: 92vh;
  }

  .debuglab-body {
    grid-template-columns: 1fr;
  }

  .debuglab-sidebar {
    display: none;
  }

  .debuglab-toolbar {
    grid-template-columns: 1fr auto;
  }

  .debuglab-task-info strong {
    font-size: 11px;
  }
}